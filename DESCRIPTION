Package: m6APrediction
Title: Prediction of m6A RNA Modification Sites
Version: 1.0.0
Authors@R:
    person("Shengjie", "Sun",
           email = "sunshengjie383@163.com",
           role = c("aut", "cre"))
Description: Provides functions for predicting N6-methyladenosine
    (m6A) RNA modification sites using a trained random forest
    model. Supports predictions for single and multiple sites
    based on sequence and genomic features.
License: MIT + file LICENSE
Imports:
    randomForest
Depends:
    R (>= 3.5.0)
Encoding: UTF-8
